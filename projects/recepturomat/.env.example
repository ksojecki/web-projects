# Optional project-local overrides for Recepturomat.
# Copy to projects/recepturomat/.env or projects/recepturomat/.env.local.

PORT=3100
WEB_PORT=4300
AUTH_DB_PATH=tmp/recepturomat/auth.sqlite
RECIPE_DB_PATH=tmp/recepturomat/recipes.sqlite
RECIPE_SEED_LEGACY_RECIPES=true
AUTH_SEED_INITIAL_USER=true
OAUTH_REDIRECT_BASE_URL=https://localhost:3100
CHROME_DEBUG_PORT=9333
CHROME_USER_DATA_DIR=tmp/chrome/recepturomat
