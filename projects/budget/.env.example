# Optional project-local overrides for Budget.
# Copy to projects/budget/.env.local and set the seeded account credentials there.

PORT=3200
WEB_PORT=4400
AUTH_DB_PATH=tmp/budget/auth.sqlite
BUDGET_DB_PATH=tmp/budget/budget.sqlite
AUTH_SEED_INITIAL_USER=true
AUTH_INITIAL_USER_EMAIL=admin@budget.local
AUTH_INITIAL_USER_PASSWORD=change-this-local-password
OAUTH_REDIRECT_BASE_URL=https://localhost:3200
CHROME_DEBUG_PORT=9444
CHROME_USER_DATA_DIR=tmp/chrome/budget
