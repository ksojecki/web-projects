{
  "name": "@ksojecki/budget-web",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ksojecki/platform-web-platform": "0.0.1",
    "i18next": "^26.3.1",
    "react-i18next": "^17.0.8",
    "react-router": "^8.0.1"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "projects/budget/apps/web",
          "command": "npx tsc --noEmit -p tsconfig.app.json && npx tsc --noEmit -p tsconfig.spec.json && npx tsc --noEmit -p tsconfig.node.json"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node node_modules/oxlint/bin/oxlint projects/budget/apps/web --config .oxlintrc.json"
        }
      },
      "build": {
        "dependsOn": [
          "build-client",
          "build-server"
        ],
        "executor": "nx:noop"
      },
      "build-client": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/dist/projects/budget/apps/web/client"
        ],
        "options": {
          "cwd": "projects/budget/apps/web",
          "command": "npx vite build --outDir ../../../../dist/projects/budget/apps/web/client"
        },
        "configurations": {
          "development": {
            "command": "npx vite build --mode development --outDir ../../../../dist/projects/budget/apps/web/client"
          },
          "production": {
            "command": "npx vite build --mode production --outDir ../../../../dist/projects/budget/apps/web/client"
          }
        }
      },
      "build-server": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/dist/projects/budget/apps/web/server"
        ],
        "options": {
          "cwd": "projects/budget/apps/web",
          "command": "npx vite build --ssr src/entry-server.tsx --outDir ../../../../dist/projects/budget/apps/web/server"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "projects/budget/apps/web",
          "command": "npx vitest run --config vite.config.mts"
        }
      },
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "projects/budget/apps/web",
          "command": "node ./node_modules/oxfmt/bin/oxfmt --write ."
        }
      }
    }
  }
}
