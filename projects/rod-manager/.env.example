# Optional project-local overrides for Rod Manager.
# Copy to projects/rod-manager/.env or projects/rod-manager/.env.local.

PORT=3000
WEB_PORT=4200
AUTH_DB_PATH=tmp/rod-manager/auth.sqlite
AUTH_SEED_INITIAL_USER=true
OAUTH_REDIRECT_BASE_URL=https://localhost:3000
CHROME_DEBUG_PORT=9222
CHROME_USER_DATA_DIR=tmp/chrome/rod-manager
